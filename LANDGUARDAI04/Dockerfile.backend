FROM python:3.12-slim

WORKDIR /app

# System deps for scientific python wheels build fallback (usually
# unnecessary since manylinux wheels exist for this arch, but keeps
# the image resilient).
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
COPY ml/models/ ./ml/models/
COPY ml/dataset/INDIA_TARGET_REGIONS_landslides.csv ./ml/dataset/

# If ml/models/landslide_model.pkl doesn't exist at build time, the
# backend still boots — it serves the rule-based fallback in
# backend/risk_engine.py and reports "model": "unavailable" on
# /health. See ml/README.md to produce a real model before deploying.

ENV PYTHONUNBUFFERED=1
EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
